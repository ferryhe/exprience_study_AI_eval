{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/benchmark-contracts/run_manifest.schema.json",
  "additionalProperties": false,
  "properties": {
    "attempts": {"items": {"$ref": "#/$defs/attempt"}, "minItems": 1, "type": "array"},
    "cache_lane": {"minLength": 1, "type": "string"},
    "cache_lane_policy": {"const": "observational_only_no_cache_state_guarantee"},
    "completed_at_utc": {"format": "date-time", "type": "string"},
    "cost": {"$ref": "#/$defs/cost"},
    "extracted_output": {"$ref": "#/$defs/extractedOutput"},
    "metrics": {"$ref": "#/$defs/metrics"},
    "prompt": {"$ref": "#/$defs/prompt"},
    "provider": {"$ref": "#/$defs/provider"},
    "replay": {"$ref": "#/$defs/replay"},
    "response": {"$ref": "#/$defs/response"},
    "run_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$", "type": "string"},
    "run_stage": {"enum": ["pilot", "confirmatory"]},
    "schema_version": {"const": "1.2.0"},
    "started_at_utc": {"format": "date-time", "type": "string"},
    "status": {"enum": ["response_contract_valid", "failed"]},
    "usage": {"$ref": "#/$defs/usage"},
    "usage_summary": {"$ref": "#/$defs/usageSummary"},
    "validation": {"$ref": "#/$defs/validation"}
  },
  "required": [
    "schema_version", "run_id", "run_stage", "status", "started_at_utc", "completed_at_utc",
    "cache_lane", "cache_lane_policy", "prompt", "provider", "attempts", "response", "extracted_output", "metrics", "usage", "cost",
    "validation", "replay", "usage_summary"
  ],
  "title": "Direct API benchmark run manifest",
  "type": "object",
  "$defs": {
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "attempt": {"minimum": 1, "type": "integer"},
        "backoff_after_ms": {"minimum": 0, "type": "number"},
        "completed_at_utc": {"format": "date-time", "type": "string"},
        "cost": {"$ref": "#/$defs/cost"},
        "elapsed_ms": {"minimum": 0, "type": "number"},
        "failure_code": {"type": ["string", "null"]},
        "raw_response_path": {"type": ["string", "null"]},
        "raw_response_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "request_id": {"type": ["string", "null"]},
        "response_produced": {"type": "boolean"},
        "retryable": {"type": "boolean"},
        "started_at_utc": {"format": "date-time", "type": "string"},
        "status_code": {"maximum": 599, "minimum": 100, "type": ["integer", "null"]},
        "usage": {"$ref": "#/$defs/usage"}
      },
      "required": [
        "attempt", "started_at_utc", "completed_at_utc", "elapsed_ms", "status_code",
        "request_id", "response_produced", "raw_response_path", "raw_response_sha256",
        "failure_code", "retryable", "backoff_after_ms", "usage", "cost"
      ],
      "type": "object"
    },
    "cost": {
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "components_usd": {
          "additionalProperties": false,
          "properties": {
            "cache_read_input": {"$ref": "#/$defs/nullable_money"},
            "cache_write_input": {"$ref": "#/$defs/nullable_money"},
            "output": {"$ref": "#/$defs/nullable_money"},
            "uncached_input": {"$ref": "#/$defs/nullable_money"}
          },
          "required": ["uncached_input", "cache_read_input", "cache_write_input", "output"],
          "type": "object"
        },
        "currency": {"const": "USD"},
        "incomplete_attempt_count": {"minimum": 0, "type": "integer"},
        "known_subtotal_usd": {"pattern": "^[0-9]+(\\.[0-9]+)?$", "type": "string"},
        "model_id_priced": {"type": ["string", "null"]},
        "service_tier_priced": {"type": ["string", "null"]},
        "pricing_snapshot_id": {"type": ["string", "null"]},
        "pricing_snapshot_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "reason_code": {"type": "string"},
        "total_usd": {"$ref": "#/$defs/nullable_money"}
      },
      "required": [
        "currency", "complete", "pricing_snapshot_id", "pricing_snapshot_sha256",
        "model_id_priced", "service_tier_priced", "components_usd", "total_usd", "known_subtotal_usd", "incomplete_attempt_count", "reason_code"
      ],
      "type": "object"
    },
    "extractedOutput": {
      "additionalProperties": false,
      "properties": {
        "byte_length": {"minimum": 0, "type": ["integer", "null"]},
        "media_type": {"enum": ["application/json", null]},
        "path": {"type": ["string", "null"]},
        "sha256": {"$ref": "#/$defs/nullable_sha256"}
      },
      "required": ["path", "sha256", "byte_length", "media_type"],
      "type": "object"
    },
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "backoff_total_ms": {"minimum": 0, "type": "number"},
        "final_attempt_latency_ms": {"minimum": 0, "type": ["number", "null"]},
        "time_to_first_token_ms": {"minimum": 0, "type": ["number", "null"]},
        "time_to_first_token_reason_code": {"type": "string"},
        "total_elapsed_ms": {"minimum": 0, "type": "number"}
      },
      "required": [
        "total_elapsed_ms", "final_attempt_latency_ms", "backoff_total_ms",
        "time_to_first_token_ms", "time_to_first_token_reason_code"
      ],
      "type": "object"
    },
    "nullable_money": {"anyOf": [{"pattern": "^[0-9]+(\\.[0-9]+)?$", "type": "string"}, {"type": "null"}]},
    "nullable_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "prompt": {
      "additionalProperties": false,
      "properties": {
        "input_bundle_sha256": {"$ref": "#/$defs/sha256"},
        "input_manifest_sha256": {"$ref": "#/$defs/sha256"},
        "model_visible_sha256": {"$ref": "#/$defs/sha256"},
        "pack_id": {"type": "string"},
        "static_pack_sha256": {"$ref": "#/$defs/sha256"}
      },
      "required": ["pack_id", "static_pack_sha256", "input_manifest_sha256", "input_bundle_sha256", "model_visible_sha256"],
      "type": "object"
    },
    "provider": {
      "additionalProperties": false,
      "properties": {
        "alias": {"type": "string"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "credential_source": {"enum": ["env_file", "process_environment"]},
        "effective_model_id": {"type": ["string", "null"]},
        "provider": {"type": "string"},
        "request_body_sha256": {"$ref": "#/$defs/sha256"},
        "requested_service_tier": {"type": "string"},
        "requested_model_id": {"type": "string"},
        "returned_model_id": {"type": ["string", "null"]},
        "returned_service_tier": {"type": ["string", "null"]}
      },
      "required": [
        "alias", "provider", "requested_model_id", "effective_model_id", "returned_model_id",
        "config_sha256", "request_body_sha256", "credential_source",
        "requested_service_tier", "returned_service_tier"
      ],
      "type": "object"
    },
    "replay": {
      "additionalProperties": false,
      "properties": {
        "python_version": {"type": "string"},
        "dependency_versions": {
          "additionalProperties": false,
          "properties": {"jsonschema": {"type": "string"}},
          "required": ["jsonschema"],
          "type": "object"
        },
        "raw_reasoning_stored": {"type": "boolean"},
        "runner_source_sha256": {"$ref": "#/$defs/sha256"},
        "runner_version": {"const": "0.3.0"},
        "source_git_commit": {"type": ["string", "null"]},
        "source_status_sha256": {"$ref": "#/$defs/sha256"},
        "source_tree_dirty": {"type": "boolean"}
      },
      "required": [
        "runner_version", "python_version", "dependency_versions", "raw_reasoning_stored", "source_git_commit",
        "source_tree_dirty", "source_status_sha256", "runner_source_sha256"
      ],
      "type": "object"
    },
    "response": {
      "additionalProperties": false,
      "properties": {
        "finish_reason": {"type": ["string", "null"]},
        "http_status": {"maximum": 599, "minimum": 100, "type": ["integer", "null"]},
        "raw_response_path": {"type": ["string", "null"]},
        "raw_response_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "request_id": {"type": ["string", "null"]}
      },
      "required": ["http_status", "request_id", "finish_reason", "raw_response_path", "raw_response_sha256"],
      "type": "object"
    },
    "sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "cache_write_input_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "input_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "integrity_failure_code": {"type": ["string", "null"]},
        "integrity_valid": {"type": "boolean"},
        "output_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "reasoning_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "total_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "uncached_input_tokens": {"minimum": 0, "type": ["integer", "null"]}
      },
      "required": [
        "input_tokens", "uncached_input_tokens", "cache_read_input_tokens",
        "cache_write_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens",
        "integrity_valid", "integrity_failure_code"
      ],
      "type": "object"
    },
    "usageSummary": {
      "additionalProperties": false,
      "properties": {
        "known_token_subtotals": {"$ref": "#/$defs/tokenCounts"},
        "missing_attempt_counts": {"$ref": "#/$defs/tokenCounts"}
      },
      "required": ["known_token_subtotals", "missing_attempt_counts"],
      "type": "object"
    },
    "tokenCounts": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {"minimum": 0, "type": "integer"},
        "cache_write_input_tokens": {"minimum": 0, "type": "integer"},
        "input_tokens": {"minimum": 0, "type": "integer"},
        "output_tokens": {"minimum": 0, "type": "integer"},
        "reasoning_tokens": {"minimum": 0, "type": "integer"},
        "total_tokens": {"minimum": 0, "type": "integer"},
        "uncached_input_tokens": {"minimum": 0, "type": "integer"}
      },
      "required": ["input_tokens", "uncached_input_tokens", "cache_read_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "type": "object"
    },
    "validation": {
      "additionalProperties": false,
      "properties": {
        "acceptance_scope": {"const": "transport_and_output_contract_only"},
        "failure_code": {"type": ["string", "null"]},
        "model_declared_status": {
          "enum": ["completed", "incomplete", "blocked", null]
        },
        "model_output_sha256": {"$ref": "#/$defs/nullable_sha256"},
        "response_schema_valid": {"type": "boolean"}
      },
      "required": [
        "response_schema_valid", "failure_code", "model_output_sha256",
        "acceptance_scope", "model_declared_status"
      ],
      "type": "object"
    }
  }
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/benchmark-contracts/capability_probe.schema.json",
  "additionalProperties": false,
  "properties": {
    "attempts": {"items": {"$ref": "#/$defs/attempt"}, "minItems": 1, "type": "array"},
    "completed_at_utc": {"format": "date-time", "type": "string"},
    "cost": {"$ref": "#/$defs/cost"},
    "metrics": {
      "additionalProperties": false,
      "properties": {
        "backoff_total_ms": {"minimum": 0, "type": "number"},
        "final_attempt_latency_ms": {"minimum": 0, "type": ["number", "null"]},
        "total_elapsed_ms": {"minimum": 0, "type": "number"}
      },
      "required": ["total_elapsed_ms", "final_attempt_latency_ms", "backoff_total_ms"],
      "type": "object"
    },
    "next_gate": {"type": "string"},
    "probe_id": {"pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,119}$", "type": "string"},
    "provider": {
      "additionalProperties": false,
      "properties": {
        "alias": {"type": "string"},
        "config_sha256": {"$ref": "#/$defs/sha256"},
        "credential_source": {"enum": ["env_file", "process_environment"]},
        "provider": {"enum": ["openai", "anthropic", "kimi", "deepseek", "minimax"]},
        "requested_model_id": {"type": "string"},
        "requested_service_tier": {"type": "string"},
        "returned_model_id": {"type": ["string", "null"]},
        "returned_service_tier": {"type": ["string", "null"]}
      },
      "required": ["alias", "provider", "requested_model_id", "returned_model_id", "config_sha256", "credential_source", "requested_service_tier", "returned_service_tier"],
      "type": "object"
    },
    "replay": {"$ref": "#/$defs/replay"},
    "request": {
      "additionalProperties": false,
      "properties": {
        "endpoint": {"format": "uri", "type": "string"},
        "model_visible_sha256": {"$ref": "#/$defs/sha256"},
        "request_body_sha256": {"$ref": "#/$defs/sha256"},
        "requested_max_output_tokens": {"maximum": 256, "minimum": 1, "type": "integer"},
        "requested_reasoning_settings": {"type": ["object", "null"]}
      },
      "required": ["endpoint", "request_body_sha256", "model_visible_sha256", "requested_reasoning_settings", "requested_max_output_tokens"],
      "type": "object"
    },
    "response": {"$ref": "#/$defs/response"},
    "schema_version": {"const": "1.0.0"},
    "started_at_utc": {"format": "date-time", "type": "string"},
    "status": {"enum": ["accepted", "rejected", "transport_failed"]},
    "usage": {"$ref": "#/$defs/usage"},
    "usage_summary": {"$ref": "#/$defs/usageSummary"},
    "validation": {
      "additionalProperties": false,
      "properties": {
        "exact_json_object_valid": {"type": "boolean"},
        "failure_code": {"type": ["string", "null"]},
        "model_output_sha256": {"$ref": "#/$defs/nullableSha256"}
      },
      "required": ["exact_json_object_valid", "failure_code", "model_output_sha256"],
      "type": "object"
    }
  },
  "required": ["schema_version", "probe_id", "status", "started_at_utc", "completed_at_utc", "provider", "request", "attempts", "response", "metrics", "usage", "usage_summary", "cost", "validation", "replay", "next_gate"],
  "title": "Capability probe record",
  "type": "object",
  "$defs": {
    "attempt": {
      "additionalProperties": false,
      "properties": {
        "attempt": {"minimum": 1, "type": "integer"},
        "backoff_after_ms": {"minimum": 0, "type": "number"},
        "completed_at_utc": {"format": "date-time", "type": "string"},
        "cost": {"$ref": "#/$defs/cost"},
        "elapsed_ms": {"minimum": 0, "type": "number"},
        "failure_code": {"type": ["string", "null"]},
        "raw_response_path": {"type": ["string", "null"]},
        "raw_response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "request_id": {"type": ["string", "null"]},
        "response_produced": {"type": "boolean"},
        "retryable": {"type": "boolean"},
        "started_at_utc": {"format": "date-time", "type": "string"},
        "status_code": {"maximum": 599, "minimum": 100, "type": ["integer", "null"]},
        "usage": {"$ref": "#/$defs/usage"}
      },
      "required": ["attempt", "started_at_utc", "completed_at_utc", "elapsed_ms", "status_code", "request_id", "response_produced", "raw_response_path", "raw_response_sha256", "failure_code", "retryable", "backoff_after_ms", "usage", "cost"],
      "type": "object"
    },
    "cost": {
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "components_usd": {
          "additionalProperties": false,
          "properties": {
            "cache_read_input": {"$ref": "#/$defs/nullableMoney"},
            "cache_write_input": {"$ref": "#/$defs/nullableMoney"},
            "output": {"$ref": "#/$defs/nullableMoney"},
            "uncached_input": {"$ref": "#/$defs/nullableMoney"}
          },
          "required": ["uncached_input", "cache_read_input", "cache_write_input", "output"],
          "type": "object"
        },
        "currency": {"const": "USD"},
        "incomplete_attempt_count": {"minimum": 0, "type": "integer"},
        "known_subtotal_usd": {"pattern": "^[0-9]+(\\.[0-9]+)?$", "type": "string"},
        "model_id_priced": {"type": ["string", "null"]},
        "pricing_snapshot_id": {"type": ["string", "null"]},
        "pricing_snapshot_sha256": {"$ref": "#/$defs/nullableSha256"},
        "reason_code": {"type": "string"},
        "service_tier_priced": {"type": ["string", "null"]},
        "total_usd": {"$ref": "#/$defs/nullableMoney"}
      },
      "required": ["currency", "complete", "pricing_snapshot_id", "pricing_snapshot_sha256", "model_id_priced", "service_tier_priced", "components_usd", "total_usd", "known_subtotal_usd", "incomplete_attempt_count", "reason_code"],
      "type": "object"
    },
    "nullableMoney": {"anyOf": [{"pattern": "^[0-9]+(\\.[0-9]+)?$", "type": "string"}, {"type": "null"}]},
    "nullableSha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "replay": {
      "additionalProperties": false,
      "properties": {
        "dependency_versions": {"additionalProperties": false, "properties": {"jsonschema": {"type": "string"}}, "required": ["jsonschema"], "type": "object"},
        "python_version": {"type": "string"},
        "raw_reasoning_stored": {"type": "boolean"},
        "runner_source_sha256": {"$ref": "#/$defs/sha256"},
        "runner_version": {"const": "0.3.0"},
        "source_git_commit": {"type": ["string", "null"]},
        "source_status_sha256": {"$ref": "#/$defs/sha256"},
        "source_tree_dirty": {"type": "boolean"}
      },
      "required": ["runner_version", "python_version", "dependency_versions", "raw_reasoning_stored", "source_git_commit", "source_tree_dirty", "source_status_sha256", "runner_source_sha256"],
      "type": "object"
    },
    "response": {
      "additionalProperties": false,
      "properties": {
        "finish_reason": {"type": ["string", "null"]},
        "http_status": {"maximum": 599, "minimum": 100, "type": ["integer", "null"]},
        "raw_response_path": {"type": ["string", "null"]},
        "raw_response_sha256": {"$ref": "#/$defs/nullableSha256"},
        "request_id": {"type": ["string", "null"]}
      },
      "required": ["http_status", "request_id", "finish_reason", "raw_response_path", "raw_response_sha256"],
      "type": "object"
    },
    "sha256": {"pattern": "^[a-f0-9]{64}$", "type": "string"},
    "tokenCounts": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {"minimum": 0, "type": "integer"},
        "cache_write_input_tokens": {"minimum": 0, "type": "integer"},
        "input_tokens": {"minimum": 0, "type": "integer"},
        "output_tokens": {"minimum": 0, "type": "integer"},
        "reasoning_tokens": {"minimum": 0, "type": "integer"},
        "total_tokens": {"minimum": 0, "type": "integer"},
        "uncached_input_tokens": {"minimum": 0, "type": "integer"}
      },
      "required": ["input_tokens", "uncached_input_tokens", "cache_read_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens"],
      "type": "object"
    },
    "usage": {
      "additionalProperties": false,
      "properties": {
        "cache_read_input_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "cache_write_input_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "input_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "integrity_failure_code": {"type": ["string", "null"]},
        "integrity_valid": {"type": "boolean"},
        "output_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "reasoning_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "total_tokens": {"minimum": 0, "type": ["integer", "null"]},
        "uncached_input_tokens": {"minimum": 0, "type": ["integer", "null"]}
      },
      "required": ["input_tokens", "uncached_input_tokens", "cache_read_input_tokens", "cache_write_input_tokens", "output_tokens", "reasoning_tokens", "total_tokens", "integrity_valid", "integrity_failure_code"],
      "type": "object"
    },
    "usageSummary": {
      "additionalProperties": false,
      "properties": {
        "known_token_subtotals": {"$ref": "#/$defs/tokenCounts"},
        "missing_attempt_counts": {"$ref": "#/$defs/tokenCounts"}
      },
      "required": ["known_token_subtotals", "missing_attempt_counts"],
      "type": "object"
    }
  }
}

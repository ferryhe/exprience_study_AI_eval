{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/model_report.schema.json",
  "title": "Evidence-linked experience-study report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_title",
    "practitioner_summary",
    "claims",
    "sections",
    "limitations",
    "exhibit_index",
    "references",
    "unresolved_issues",
    "word_counts"
  ],
  "$defs": {
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[A-Z][A-Z0-9_-]{2,127}$"
      }
    },
    "numeric_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit", "population", "period", "basis"],
      "properties": {
        "value": {
          "type": ["string", "null"],
          "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "population": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "period": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "claim_id",
        "claim_type",
        "text",
        "epistemic_status",
        "material",
        "evidence_ids",
        "numeric_values"
      ],
      "properties": {
        "claim_id": {
          "type": "string",
          "pattern": "^CLM-[0-9]{4}$"
        },
        "claim_type": {
          "enum": [
            "numeric",
            "comparative",
            "qualitative",
            "methodology",
            "limitation",
            "governance"
          ]
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "epistemic_status": {
          "enum": ["evidence_fact", "inference", "limitation", "unresolved"]
        },
        "material": {
          "type": "boolean"
        },
        "evidence_ids": {
          "$ref": "#/$defs/evidence_ids"
        },
        "numeric_values": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/numeric_value"
          }
        }
      }
    },
    "paragraph": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "claim_ids"],
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 10000
        },
        "claim_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^CLM-[0-9]{4}$"
          }
        }
      }
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "report_title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "practitioner_summary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["paragraphs"],
      "properties": {
        "paragraphs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/paragraph"
          }
        }
      }
    },
    "claims": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "title", "paragraphs"],
        "properties": {
          "section_id": {
            "enum": [
              "R01_EXECUTIVE_FINDINGS",
              "R02_DATA_VALIDATION",
              "R03_POPULATIONS_EXPECTED_BASIS",
              "R04_EXPOSURE_AND_TRENDS",
              "R05_PRODUCT_RESULTS",
              "R06_SEX_SMOKER_RISK_CLASS",
              "R07_AGE_AND_DURATION",
              "R08_MODEL_DIAGNOSTICS",
              "R09_PRACTICAL_IMPLICATIONS",
              "R10_LIMITATIONS_GOVERNANCE",
              "R11_REPRODUCIBILITY_REFERENCES"
            ]
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "paragraphs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 100,
            "items": {
              "$ref": "#/$defs/paragraph"
            }
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["limitation_id", "text", "material", "evidence_ids"],
        "properties": {
          "limitation_id": {
            "type": "string",
            "pattern": "^LIM-[0-9]{3}$"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "material": {
            "type": "boolean"
          },
          "evidence_ids": {
            "$ref": "#/$defs/evidence_ids"
          }
        }
      }
    },
    "exhibit_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["exhibit_id", "title", "evidence_ids"],
        "properties": {
          "exhibit_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "evidence_ids": {
            "$ref": "#/$defs/evidence_ids"
          }
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["reference_id", "title", "source"],
        "properties": {
          "reference_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "source": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        }
      }
    },
    "unresolved_issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["issue_id", "description", "affected_claim_ids"],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^ISS-[0-9]{3}$"
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 3000
          },
          "affected_claim_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^CLM-[0-9]{4}$"
            }
          }
        }
      }
    },
    "word_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["main_report", "practitioner_summary"],
      "properties": {
        "main_report": {
          "type": "integer",
          "minimum": 0
        },
        "practitioner_summary": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
